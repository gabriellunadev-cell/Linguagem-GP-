programa "Biblioteca padrão inicial da GP"

lista texto partes = ["Gabriel", " ", "Programming", " 🚀"]
texto saudacao = unir_textos(partes)
mostrar("Junção: ", saudacao)
mostrar("Caracteres: ", tamanho(saudacao))

lista numero valores = [10, 20, 30]
adicionar(valores, 40)
numero removido = remover(valores, 1)
mostrar("Removido: ", removido)
mostrar("Lista final: ", valores)
mostrar("Quantidade final: ", tamanho(valores))
