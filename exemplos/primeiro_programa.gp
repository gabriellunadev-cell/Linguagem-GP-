programa "Primeiro programa GP"

texto nome = "Gabriel Luna"
numero versao = 1.0
numero resultado = (10 + 5) * 2
logico android = verdadeiro

mostrar("Linguagem GP inicializada!")
mostrar(nome)
mostrar(versao)
mostrar(resultado)

se (android && resultado == 30) {
    mostrar("Execução Android-first confirmada.")
} senao {
    mostrar("Condição não atendida.")
}
