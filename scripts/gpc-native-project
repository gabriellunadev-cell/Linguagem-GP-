#!/bin/sh
# Native GP project compiler. Python is the orchestration/secure filesystem host;
# the GP-owned graph resolver and self-hosted frontend execute on the C VM.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PYTHON=${GP_PYTHON:-python3}
VM=${GP_NATIVE_VM:-"$ROOT/build/gpvm-native"}
if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    echo "Uso: scripts/gpc-native-project arquivo.gp [saida.gbc]" >&2
    exit 2
fi
SOURCE=$1
OUTPUT=${2:-"${SOURCE%.*}.gbc"}
[ -f "$SOURCE" ] || { echo "Fonte GP não encontrada: $SOURCE" >&2; exit 2; }
[ -x "$VM" ] || { echo "VM nativa não encontrada/executável: $VM" >&2; exit 2; }
exec "$PYTHON" "$ROOT/gp_compile.py" "$SOURCE" -o "$OUTPUT" \
    --self-hosted --runner-vm native --native-vm "$VM" \
    --run-vm native --run
